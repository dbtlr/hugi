[
  {
    "name": "Install dependencies",
    "script": "pnpm install --frozen-lockfile"
  },
  {
    "name": "Install the programs the tests run",
    "script": "brew install fish\npwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'\n"
  },
  {
    "name": "Build, check types, and run the tests under Bun",
    "script": "pnpm verify:bun"
  },
  {
    "name": "Run the packed consumer",
    "script": "pnpm check:packed"
  }
]
